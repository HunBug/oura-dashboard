<Project>
  <PropertyGroup>
    <!-- Workaround for .NET 10 preview prune package data issue -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

    <!-- Bump this before every release. push.sh enforces no re-tag without the force flag -->
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
