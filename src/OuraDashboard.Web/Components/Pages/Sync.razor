@page "/sync"
@rendermode InteractiveServer
@implements IDisposable

@inject ISyncTrigger SyncTrigger
@inject IOptions<OuraOptions> OuraOptions
@inject IOptions<WeatherOptions> WeatherOptions
@inject DashboardQueryService DbQuery

<PageTitle>Sync</PageTitle>

<h1>Sync</h1>

<h2 class="h5 mt-3">Oura</h2>
<div class="mb-3 d-flex flex-wrap gap-2">
    <button class="btn btn-primary" @onclick="RequestSync" disabled="@_state.IsRunning">
        @if (_state.IsRunning)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Syncing&hellip;</span>
        }
        else
        {
            <span>Refresh now</span>
        }
    </button>
    <button class="btn btn-warning" @onclick="RequestFullSync" disabled="@_state.IsRunning"
            title="Fetches the full FullSyncLookbackDays window (default 90 days) for all users">
        Full reload (90 days)
    </button>
</div>

<h2 class="h5 mt-3">Weather</h2>
<div class="mb-3 d-flex flex-wrap gap-2">
    <button class="btn btn-outline-primary" @onclick="RequestWeatherSync" disabled="@_state.IsRunning">
        Weather refresh now
    </button>
    <button class="btn btn-outline-warning" @onclick="RequestFullWeatherSync" disabled="@_state.IsRunning"
            title="Fetches the configured Weather:FullSyncLookbackDays window and refreshes existing rows inside that window.">
        Weather historical reload
    </button>
</div>

<dl class="row" style="max-width: 480px">
    <dt class="col-5">Status</dt>
    <dd class="col-7">@(_state.IsRunning ? "Running" : "Idle")</dd>

    <dt class="col-5">Last sync</dt>
    <dd class="col-7">@(_state.LastSyncAt.HasValue ? FormatTimestamp(_state.LastSyncAt.Value) : "—")</dd>

    <dt class="col-5">Last weather sync</dt>
    <dd class="col-7">@(_state.LastWeatherSyncAt.HasValue ? FormatTimestamp(_state.LastWeatherSyncAt.Value) : "—")</dd>

    <dt class="col-5">Oura auto sync</dt>
    <dd class="col-7">@AutoSyncText(OuraOptions.Value.AutoSyncEnabled, $"{OuraOptions.Value.SyncIntervalMinutes} min")</dd>

    <dt class="col-5">Weather auto sync</dt>
    <dd class="col-7">@AutoSyncText(WeatherOptions.Value.Enabled && WeatherOptions.Value.AutoSyncEnabled, $"{WeatherOptions.Value.SyncIntervalHours} h")</dd>
</dl>

@if (_state.LastResults.Count > 0)
{
    <h2 class="h5 mt-3">Last results</h2>
    <table class="table table-sm" style="max-width: 760px">
        <thead>
            <tr>
                <th>User</th>
                <th>Range</th>
                <th>DailySleep</th>
                <th>Sessions</th>
                <th>Readiness</th>
                <th>Activity</th>
                <th>HR samples</th>
                <th>SpO2</th>
                <th>Resilience</th>
                <th>Workouts</th>
                <th>Errors</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _state.LastResults)
            {
                <tr>
                    <td>@r.UserName</td>
                    <td>@r.Start – @r.End</td>
                    <td>@r.DailySleepCount</td>
                    <td>@r.SleepSessionCount</td>
                    <td>@r.ReadinessCount</td>
                    <td>@r.DailyActivityCount</td>
                    <td>@r.HeartRateSampleCount</td>
                    <td>@r.Spo2Count</td>
                    <td>@r.ResilienceCount</td>
                    <td>@r.WorkoutCount</td>
                    <td>@r.Errors.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_state.LastWeatherResult is not null)
{
    var w = _state.LastWeatherResult;
    <h2 class="h5 mt-3">Last weather sync result</h2>
    <table class="table table-sm" style="max-width: 760px">
        <thead>
            <tr>
                <th>Location</th>
                <th>Range UTC</th>
                <th>Open-Meteo new</th>
                <th>Estonian agency new</th>
                <th>Stations</th>
                <th>Errors</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@w.LocationName</td>
                <td>@w.StartUtc.ToString("yyyy-MM-dd HH:mm") – @w.EndUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@w.OpenMeteoCount</td>
                <td>@w.EstonianAgencyCount</td>
                <td>@w.StationCount</td>
                <td>@w.Errors.Count</td>
            </tr>
        </tbody>
    </table>
}

<h2 class="h5 mt-4">DB totals — Oura</h2>
@if (_ouraStats is null)
{
    <p class="text-muted small">Loading…</p>
}
else
{
    <table class="table table-sm" style="max-width: 480px">
        <thead>
            <tr>
                <th>User</th>
                <th>Days synced</th>
                <th>Earliest day</th>
                <th>Latest day</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _ouraStats)
            {
                <tr>
                    <td>@s.UserName</td>
                    <td>@s.Days</td>
                    <td>@(s.EarliestDay?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>@(s.LatestDay?.ToString("yyyy-MM-dd") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-3">DB totals — Weather</h2>
@if (_weatherStats is null)
{
    <p class="text-muted small">Loading…</p>
}
else if (_weatherStats.Count == 0)
{
    <p class="text-muted small">No weather data in DB yet.</p>
}
else
{
    <table class="table table-sm" style="max-width: 640px">
        <thead>
            <tr>
                <th>Source</th>
                <th>Samples in DB</th>
                <th>Pressure</th>
                <th>Sun</th>
                <th>Earliest (UTC)</th>
                <th>Latest (UTC)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _weatherStats)
            {
                <tr>
                    <td>@s.Source</td>
                    <td>@s.Count</td>
                    <td>@s.PressureSamples</td>
                    <td>@s.SunshineSamples</td>
                    <td>@(s.EarliestUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td>@(s.LatestUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (_weatherStats.All(s => s.PressureSamples == 0 || s.SunshineSamples == 0))
    {
        <p class="text-muted small">
            Weather context chips need pressure and sunshine rows for the same dates as the Oura nights. Estonian agency rows may still be unusable for those chips if they only contain temperature, humidity, or precipitation.
        </p>
    }
}

<h2 class="h5 mt-3">Weather context diagnostics</h2>
@if (_weatherDebug is null)
{
    <p class="text-muted small">Loading…</p>
}
else if (_weatherDebug.Count == 0)
{
    <p class="text-muted small">No Oura nights available to diagnose.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm" style="max-width: 1120px">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Night</th>
                    <th>Night window</th>
                    <th>Night raw</th>
                    <th>Night chip</th>
                    <th>Previous day window</th>
                    <th>Day raw</th>
                    <th>Sun chip</th>
                    <th>Day pressure chip</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _weatherDebug)
                {
                    <tr>
                        <td>@row.UserName</td>
                        <td>@row.Day.ToString("yyyy-MM-dd")</td>
                        <td>@FormatWindow(row.NightStartLocal, row.NightEndLocal)</td>
                        <td>@FormatCounts(row.NightCounts)</td>
                        <td>@FormatPressure(row.Context?.NightPressure)</td>
                        <td>@FormatWindow(row.PreviousDayStartLocal, row.PreviousDayEndLocal)</td>
                        <td>@FormatCounts(row.PreviousDayCounts)</td>
                        <td>@FormatSun(row.Context?.PreviousDaySun)</td>
                        <td>@FormatPressure(row.Context?.PreviousDayPressure)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_state.LastErrors.Count > 0)
{
    <div class="alert alert-danger mt-3">
        <strong>Errors</strong>
        <ul class="mb-0 mt-1">
            @foreach (var err in _state.LastErrors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

@code {
    private SyncState _state = new();
    private Timer? _pollTimer;
    private TimeZoneInfo _displayTimeZone = TimeZoneInfo.Local;
    private List<OuraDbStats>? _ouraStats;
    private List<WeatherDbSourceStats>? _weatherStats;
    private List<WeatherContextDebugRow>? _weatherDebug;

    protected override async Task OnInitializedAsync()
    {
        _displayTimeZone = OuraTimeZone.Resolve(OuraOptions.Value.DisplayTimeZoneId);
        _state = SyncTrigger.State;
        await RefreshDbStatsAsync();
        // Poll every 2 s so the spinner/results update without needing StreamRendering
        _pollTimer = new Timer(async _ =>
        {
            _state = SyncTrigger.State;
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task RefreshDbStatsAsync()
    {
        _ouraStats = await DbQuery.GetOuraDbStatsAsync();
        _weatherStats = await DbQuery.GetWeatherDbStatsAsync();
        _weatherDebug = await DbQuery.GetRecentWeatherContextDebugAsync(
            OuraOptions.Value.Users.Select(u => u.Name).Where(n => !string.IsNullOrWhiteSpace(n)).ToList());
    }

    private async Task RequestSync()
    {
        SyncTrigger.RequestSync();
        _state = SyncTrigger.State;
        await RefreshDbStatsAsync();
    }

    private async Task RequestFullSync()
    {
        SyncTrigger.RequestFullSync();
        _state = SyncTrigger.State;
        await RefreshDbStatsAsync();
    }

    private async Task RequestWeatherSync()
    {
        SyncTrigger.RequestWeatherSync();
        _state = SyncTrigger.State;
        await RefreshDbStatsAsync();
    }

    private async Task RequestFullWeatherSync()
    {
        SyncTrigger.RequestFullWeatherSync();
        _state = SyncTrigger.State;
        await RefreshDbStatsAsync();
    }

    private string FormatTimestamp(DateTimeOffset timestamp) =>
        TimeZoneInfo.ConvertTime(timestamp, _displayTimeZone).ToString("g");

    private static string AutoSyncText(bool enabled, string interval) =>
        enabled ? $"enabled, every {interval}" : "disabled";

    private static string FormatWindow(DateTime start, DateTime end) =>
        $"{start:MM-dd HH:mm} – {end:MM-dd HH:mm}";

    private static string FormatCounts(WeatherWindowSampleCounts counts) =>
        $"{counts.Rows} rows; pressure {counts.PressureRows}; sun {counts.SunshineRows}; {counts.SourceLabels}";

    private static string FormatPressure(WeatherPressureContext? item) =>
        item is null
            ? "—"
            : item.PressureChangeHpa.HasValue && item.Level != WeatherLevels.Insufficient
                ? $"{item.PressureChangeHpa.Value:F1} hPa {item.Level} ({item.ValidSamples}/{item.ExpectedSamples}, {item.SourceLabel})"
                : $"{item.Level} ({item.ValidSamples}/{item.ExpectedSamples}, {item.SourceLabel ?? "no source"})";

    private static string FormatSun(WeatherSunContext? item) =>
        item is null
            ? "—"
            : item.SunnyHours.HasValue && item.Level != WeatherLevels.Insufficient
                ? $"{item.SunnyHours.Value:F1}h {item.Level} ({item.ValidSamples}/{item.ExpectedSamples}, {item.SourceLabel})"
                : $"{item.Level} ({item.ValidSamples}/{item.ExpectedSamples}, {item.SourceLabel ?? "no source"})";

    public void Dispose() => _pollTimer?.Dispose();
}
