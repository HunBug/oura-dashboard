@page "/debug/llm-sandbox"
@rendermode InteractiveServer

@using System.Text.Json
@inject LlmDebugLog DebugLog
@inject NightLlmService NightLlm
@inject ILlmClient LlmClient
@inject IOptions<LlmOptions> LlmOptions

<PageTitle>LLM Sandbox</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <h4 class="mb-0">LLM Sandbox</h4>
    @if (!LlmOptions.Value.Enabled)
    {
        <span class="badge text-bg-secondary">disabled</span>
    }
    else if (NightLlm.IsSandboxMode)
    {
        <span class="badge text-bg-warning text-dark">sandbox — no DB writes</span>
    }
    else
    {
        <span class="badge text-bg-success">live — DB writes enabled</span>
    }
    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="Refresh">Refresh</button>
</div>

<p class="text-muted small mb-4">
    Shows the last 3 LLM calls made in this server session (in-memory, not stored in DB).
    Use <a href="/night/Boo/2026-05-19">/night/{name}/{day}</a> to trigger a generation, then come back here.
</p>

@if (!LlmOptions.Value.Enabled)
{
    <div class="alert alert-secondary">LLM is disabled. Set <code>Llm.Enabled = true</code> in your local settings to use it.</div>
}

@{
    var entries = _entries;
}

@if (entries.Count == 0)
{
    <p class="text-muted">No LLM calls recorded yet this session. Trigger a generation from any night detail page.</p>
}
else
{
    @foreach (var (entry, index) in entries.Select((e, i) => (e, i)))
    {
        var idx = index;
        <div class="card mb-4 @(entry.IsSandbox ? "border-warning" : "")">
            <div class="card-header d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-semibold">#@(entries.Count - idx)</span>
                <span class="text-muted small">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                <span class="badge text-bg-secondary">@entry.Scope</span>
                <span class="badge text-bg-primary">@entry.Model</span>
                @if (entry.IsSandbox)
                {
                    <span class="badge text-bg-warning text-dark">sandbox</span>
                }
                @if (entry.LatencyMs.HasValue)
                {
                    <span class="text-muted small ms-auto">@entry.LatencyMs ms</span>
                }
                @if (entry.ErrorCode is not null)
                {
                    <span class="badge text-bg-danger">@entry.ErrorCode</span>
                }
                <button class="btn btn-sm btn-outline-primary @(entry.LatencyMs.HasValue ? "" : "ms-auto")"
                        @onclick="() => LoadEditor(entry)">
                    Edit ↓
                </button>
            </div>

            <div class="card-body p-0">

                @* ── Response text ── *@
                <div class="p-3 border-bottom">
                    <div class="fw-semibold small text-muted mb-1">Response</div>
                    @if (!string.IsNullOrWhiteSpace(entry.ResponseText))
                    {
                        <div style="white-space:pre-wrap;" class="small">@entry.ResponseText</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(entry.ErrorMessage))
                    {
                        <div class="text-danger small">@entry.ErrorMessage</div>
                    }
                    else
                    {
                        <div class="text-muted small">No response.</div>
                    }
                </div>

                @* ── Messages (prompts) ── *@
                <div class="p-3 border-bottom">
                    <button class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold small text-muted"
                            @onclick="() => ToggleSection(idx, 0)">
                        @(IsOpen(idx, 0) ? "▾" : "▸") Prompts sent (@(CountMessages(entry.MessagesJson)) messages)
                    </button>
                    @if (IsOpen(idx, 0))
                    {
                        <div class="mt-2">
                            @foreach (var msg in ParseMessages(entry.MessagesJson))
                            {
                                <div class="mb-3">
                                    <div class="badge text-bg-secondary mb-1">@msg.Role</div>
                                    <pre class="small bg-light p-2 rounded mb-0" style="white-space:pre-wrap;word-break:break-word;">@msg.Content</pre>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* ── Raw Ollama request ── *@
                @if (entry.RawRequestJson is not null)
                {
                    <div class="p-3 border-bottom">
                        <button class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold small text-muted"
                                @onclick="() => ToggleSection(idx, 1)">
                            @(IsOpen(idx, 1) ? "▾" : "▸") Raw Ollama request JSON
                        </button>
                        @if (IsOpen(idx, 1))
                        {
                            <pre class="small bg-light p-2 rounded mt-2 mb-0" style="white-space:pre-wrap;word-break:break-word;">@PrettyJson(entry.RawRequestJson)</pre>
                        }
                    </div>
                }

                @* ── Raw Ollama response ── *@
                @if (entry.RawResponseJson is not null)
                {
                    <div class="p-3">
                        <button class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold small text-muted"
                                @onclick="() => ToggleSection(idx, 2)">
                            @(IsOpen(idx, 2) ? "▾" : "▸") Raw Ollama response JSON
                        </button>
                        @if (IsOpen(idx, 2))
                        {
                            <pre class="small bg-light p-2 rounded mt-2 mb-0" style="white-space:pre-wrap;word-break:break-word;">@PrettyJson(entry.RawResponseJson)</pre>
                        }
                    </div>
                }

            </div>
        </div>
    }
}

@* ── Prompt Playground ── *@
<div class="card border-info mt-2">
    <div class="card-header fw-semibold text-info-emphasis">
        Prompt Playground
        <span class="text-muted fw-normal small ms-2">edit &amp; resend — result appears above as a new entry</span>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label small fw-semibold">Model</label>
            <input class="form-control form-control-sm font-monospace" @bind="_playModel" />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold">System prompt</label>
            <textarea class="form-control form-control-sm font-monospace" rows="6"
                      @bind="_playSystem" style="resize:vertical;"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold">User message</label>
            <textarea class="form-control form-control-sm font-monospace" rows="14"
                      @bind="_playUser" style="resize:vertical;"></textarea>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="SendPlayground" disabled="@_playing">
            @if (_playing)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Sending…</span>
            }
            else
            {
                <span>Send</span>
            }
        </button>

        @if (_playResponse is not null || _playError is not null)
        {
            <div class="mt-3 border-top pt-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fw-semibold small">Last playground response</span>
                    @if (_playLatencyMs.HasValue)
                    {
                        <span class="text-muted small">@_playLatencyMs ms</span>
                    }
                </div>
                @if (_playError is not null)
                {
                    <div class="text-danger small">@_playError</div>
                }
                else
                {
                    <div style="white-space:pre-wrap;" class="small">@_playResponse</div>
                }
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<LlmDebugEntry> _entries = [];

    // [entryIndex][sectionIndex] → open?
    private readonly Dictionary<(int, int), bool> _open = new();

    // Playground state
    private string _playModel = "";
    private string _playSystem = "";
    private string _playUser = "";
    private bool _playing;
    private string? _playResponse;
    private string? _playError;
    private int? _playLatencyMs;

    protected override void OnInitialized()
    {
        _entries = DebugLog.GetRecent();
        _playModel = LlmOptions.Value.Model;
    }

    private void Refresh() => _entries = DebugLog.GetRecent();

    private void LoadEditor(LlmDebugEntry entry)
    {
        _playModel = entry.Model;
        var msgs = ParseMessages(entry.MessagesJson);
        _playSystem = msgs.FirstOrDefault(m => m.Role == "system").Content ?? "";
        _playUser = msgs.FirstOrDefault(m => m.Role == "user").Content ?? "";
        _playResponse = null;
        _playError = null;
        _playLatencyMs = null;
    }

    private async Task SendPlayground()
    {
        if (_playing) return;
        _playing = true;
        _playResponse = null;
        _playError = null;
        _playLatencyMs = null;

        var opts = LlmOptions.Value;
        var messages = new LlmMessage[]
        {
            new("system", _playSystem),
            new("user", _playUser),
        };
        var parameters = new LlmParameters(opts.Temperature, opts.TopP, opts.TopK, opts.RepeatPenalty, opts.NumPredict, opts.NumCtx);
        var messagesJson = JsonSerializer.Serialize(messages);
        var now = DateTimeOffset.UtcNow;

        string? rawRequestJson = null, rawResponseJson = null;
        try
        {
            var response = await LlmClient.CompleteChatAsync(new LlmChatRequest(_playModel, messages, parameters, opts.KeepAlive), CancellationToken.None);
            _playResponse = response.Text;
            _playLatencyMs = response.LatencyMs;
            rawRequestJson = response.RawRequestJson;
            rawResponseJson = response.RawResponseJson;

            DebugLog.Push(new LlmDebugEntry
            {
                Timestamp = now,
                Scope = "playground",
                Model = _playModel,
                MessagesJson = messagesJson,
                RawRequestJson = rawRequestJson,
                RawResponseJson = rawResponseJson,
                ResponseText = response.Text,
                LatencyMs = response.LatencyMs,
                IsSandbox = true,
            });
        }
        catch (LlmClientException ex)
        {
            _playError = $"[{ex.Code}] {ex.Message}";
            rawRequestJson = ex.RawRequestJson;
            rawResponseJson = ex.RawResponseJson;

            DebugLog.Push(new LlmDebugEntry
            {
                Timestamp = now,
                Scope = "playground",
                Model = _playModel,
                MessagesJson = messagesJson,
                RawRequestJson = rawRequestJson,
                RawResponseJson = rawResponseJson,
                ErrorCode = ex.Code,
                ErrorMessage = ex.Message,
                IsSandbox = true,
            });
        }
        catch (Exception ex)
        {
            _playError = ex.Message;
        }
        finally
        {
            _playing = false;
            _entries = DebugLog.GetRecent();
        }
    }

    private void ToggleSection(int entry, int section)
    {
        var key = (entry, section);
        _open[key] = !_open.GetValueOrDefault(key);
    }

    private bool IsOpen(int entry, int section) => _open.GetValueOrDefault((entry, section));

    private static IReadOnlyList<(string Role, string Content)> ParseMessages(string json)
    {
        try
        {
            var msgs = JsonSerializer.Deserialize<JsonElement[]>(json);
            if (msgs is null) return [];
            return msgs
                .Select(m => (
                    Role: m.TryGetProperty("role", out var r) ? r.GetString() ?? "" : "",
                    Content: m.TryGetProperty("content", out var c) ? c.GetString() ?? "" : ""))
                .ToList();
        }
        catch { return []; }
    }

    private static int CountMessages(string json)
    {
        try { return JsonSerializer.Deserialize<JsonElement[]>(json)?.Length ?? 0; }
        catch { return 0; }
    }

    private static string PrettyJson(string json)
    {
        try
        {
            var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }
}
