@inject AppLogSink LogSink

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">OuraDashboard</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sync">
                <span class="bi bi-arrow-repeat-nav-menu" aria-hidden="true"></span> Sync
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="user/Boo">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Boo's History
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="user/Maa">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Maa's History
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="compare">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Compare
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="raw">
                <span class="bi bi-download-nav-menu" aria-hidden="true"></span> Raw Export
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="debug/investigate">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Debug Investigate
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="debug/llm-sandbox">
                <span class="bi bi-chat-dots-nav-menu" aria-hidden="true"></span> LLM Sandbox
            </NavLink>
        </div>

        @if (LogSink.ErrorCount > 0 || LogSink.WarningCount > 0)
        {
            <div class="nav-item px-3 mt-1">
                <NavLink class="nav-link nav-link-alert" href="debug/investigate">
                    ⚠
                    @if (LogSink.ErrorCount > 0)
                    {
                        <span class="text-danger">@LogSink.ErrorCount error@(LogSink.ErrorCount != 1 ? "s" : "")</span>
                    }
                    @if (LogSink.WarningCount > 0)
                    {
                        <span class="text-warning ms-1">@LogSink.WarningCount warn@(LogSink.WarningCount != 1 ? "s" : "")</span>
                    }
                </NavLink>
            </div>
        }

        <div class="nav-footer px-3 mt-auto">
            <div class="small">v@(BuildInfo.Version)</div>
            <div class="small">@(BuildInfo.BuildTime.ToString("yyyy-MM-dd HH:mm")) UTC</div>
        </div>
    </nav>
</div>
