# oura-dashboard — server environment variables
#
# Copy this file to .env and fill in real values:
#   cp .env.template .env
#   nano .env
#
# .env is gitignored and must NEVER be committed.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by both the postgres container and the Blazor app's connection string.
# Use a long random password (e.g. pwgen -s 32 1).
DB_PASSWORD=changeme_strong_password

# ─── Oura personal access tokens ──────────────────────────────────────────────
# Generate at https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN_BOO=your_boo_oura_token_here
OURA_TOKEN_MAA=your_maa_oura_token_here

# ─── Optional overrides ────────────────────────────────────────────────────────
# OURA_SYNC_INTERVAL_MINUTES=60
