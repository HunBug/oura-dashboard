# oura-dashboard — server environment variables
#
# Copy this file to .env and fill in real values:
#   cp .env.template .env
#   nano .env
#
# .env is gitignored and must NEVER be committed.
# App settings and application secrets are mounted from appsettings.json.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by the postgres container. Keep the same value in mounted appsettings.json:
#   ConnectionStrings:Default = Host=postgres;Port=5432;Database=oura;Username=oura;Password=...
# Use a long random password (e.g. pwgen -s 32 1).
DB_PASSWORD=changeme_strong_password
